{
  "name": "@geekfeed/mcp-twilio-monitor",
  "version": "1.0.0",
  "description": "MCP Server for Twilio Monitor API - Access Twilio alerts and events from Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-twilio-monitor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "twilio",
    "twilio-monitor",
    "monitor",
    "alerts",
    "events",
    "claude",
    "claude-code",
    "model-context-protocol"
  ],
  "author": "Shinji Uchi / GeekFeed Co.,Ltd. (https://www.geekfeed.co.jp)",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE",
    ".env.example"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
